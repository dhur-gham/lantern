{
    "name": "dhur-gham/lantern",
    "description": "Trace Laravel requests end-to-end and detect N+1, slow and duplicate queries and memory growth.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "profiler", "n+1", "debug", "livewire"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": { "Lantern\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lantern\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Lantern\\LanternServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
